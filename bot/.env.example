# Required: your Telegram bot token from @BotFather
BOT_TOKEN=

# Optional: directory for temporary downloads (default: /tmp/tgbot_downloads)
# DOWNLOAD_DIR=/tmp/tgbot_downloads

# Optional: max file size in MB for Telegram uploads (default: 50)
# MAX_FILE_MB=50

# Optional: proxy for yt-dlp to bypass datacenter IP blocks
# Use a residential proxy for TikTok/Instagram. Examples:
# PROXY=socks5://user:pass@host:port
# PROXY=http://user:pass@host:port
